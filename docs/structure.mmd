classDiagram
    direction TB
    %% Branded Component Map
    %% Author: FJ-cyberzilla
    %% Org: FJ™ Cybertronic Systems
    
    class OSINTApp {
        +compose()
        +on_scan_update()
        +update_dashboard()
        +update_advanced_intel()
    }
    
    class IntelligenceDashboard {
        +update_data()
    }
    
    class TelemetryPanel {
        +update_telemetry()
    }
    
    class RelationshipPanel {
        +update_relationships()
    }
    
    class HeatmapPanel {
        +update_heatmap()
    }
    
    OSINTApp --> IntelligenceDashboard
    OSINTApp --> TelemetryPanel
    OSINTApp --> RelationshipPanel
    OSINTApp --> HeatmapPanel
    
    class AdvancedReportGenerator {
        +generate(username)
    }
    
    class ScanOrchestrator {
        +run_scan()
        +abort()
    }
    
    class HealthTracker {
        +check_status()
        +auto_heal()
    }
    
    class DeviceInferenceService {
        +infer_context()
    }
    
    class DatabaseManager {
        +save_result()
        +save_batch()
        +get_cached()
        +set_cached()
        +search()
    }
    
    class CaptchaRegistry {
        +solve()
        +register_solver()
    }
    
    class BrowserPool {
        +get_instance()
        +recycle()
    }
    
    class BrowserEngine {
        <<interface>>
        +run_navigation(url)
    }
    
    class PyQtBrowserEngine {
        +run_navigation(url)
    }
    
    class PlaywrightBrowserEngine {
        +run_navigation(url)
    }
    
    class TelemetryBridge {
        +collect_probes()
        +report()
    }
    
    class DetectionEngine {
        +analyze_entropy()
    }
    
    class ExporterEngine {
        +export_stix()
    }
    
    class Provider {
        <<interface>>
        +scan()
    }

    class ComplianceEngine {
        +sanitize(data)
    }

    OSINTAgent --> ScanOrchestrator
    OSINTAgent --> AdvancedReportGenerator
    AdvancedReportGenerator --> DatabaseManager
    ScanOrchestrator --> HealthTracker
    ScanOrchestrator --> DeviceInferenceService
    ScanOrchestrator --> DatabaseManager
    ScanOrchestrator --> CaptchaRegistry
    ScanOrchestrator --> BrowserPool
    BrowserPool --> BrowserEngine
    BrowserEngine <|-- PyQtBrowserEngine
    BrowserEngine <|-- PlaywrightBrowserEngine
    ScanOrchestrator --> TelemetryBridge
    ScanOrchestrator --> DetectionEngine
    ScanOrchestrator --> ExporterEngine
    ScanOrchestrator --> Provider
    ScanOrchestrator --> ComplianceEngine
    
    Provider <|-- GithubProvider
    Provider <|-- GenericProvider
    Provider <|-- AparatProvider
