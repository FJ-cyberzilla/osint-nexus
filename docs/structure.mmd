classDiagram
    class OSINTAgent {
        +AgentSubsystems subsystems
        +run_scan()
        +get_final_report()
    }
    
    class AgentSubsystems {
        +ScanOrchestrator orchestrator
        +HealthTracker health
        +ReportGenerator report
        +DeviceInferenceService device_inference
        +ComplianceEngine compliance
        +List~Exporter~ exporters
    }
    
    class ScanOrchestrator {
        +run_scan()
        +abort()
    }
    
    class DeviceInferenceService {
        +infer()
    }

    class ComplianceEngine {
        +sanitize(data)
    }

    class Exporter {
        <<interface>>
        +export(data)
    }
    
    OSINTAgent --> AgentSubsystems
    AgentSubsystems o-- ScanOrchestrator
    AgentSubsystems o-- HealthTracker
    AgentSubsystems o-- ReportGenerator
    AgentSubsystems o-- DeviceInferenceService
    AgentSubsystems o-- ComplianceEngine
    AgentSubsystems o-- Exporter
    ScanOrchestrator --> DeviceInferenceService
    ReportGenerator --> ComplianceEngine
    ReportGenerator --> Exporter
